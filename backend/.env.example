APP_NAME=Hackathon API
DATABASE_URL=sqlite:///./app.db
CORS_ORIGINS=["http://localhost:3000"]
# Add API keys here, e.g.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Get a key at https://openrouter.ai/keys  (backend only, never in the frontend)
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models (openrouter/auto lets OpenRouter pick)
LLM_MODEL=openrouter/auto

# Vision-capable model used to read handwriting (pick one that accepts image input
# at https://openrouter.ai/models). Empty = use LLM_MODEL.
VISION_MODEL=
